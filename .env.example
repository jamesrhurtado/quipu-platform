# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Database
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# NASA APIs
NASA_API_KEY=DEMO_KEY
NASA_FIRMS_MAP_KEY=your-firms-map-key

# ReliefWeb app identifier (not a user-facing name, keep stable)
RELIEFWEB_APPNAME=sentinel-agent

# Bluesky social feed (real-time disaster mentions)
BLUESKY_ENABLED=false

# Bluesky notifications (posting alerts)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_NOTIFICATIONS_ENABLED=false

# Microsoft Teams
TEAMS_ENABLED=true
TEAMS_WEBHOOK_URL=

# Dashboard URL (used in Teams Adaptive Card links)
DASHBOARD_URL=http://localhost:3000

# App Config
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
